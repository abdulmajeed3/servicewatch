# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
HOST=

# ─── Database ─────────────────────────────────────────────────────────────────
# Use DATABASE_URL for a single connection string, or individual variables below.
# DATABASE_URL=postgres://servicewatch:password@localhost:5432/servicewatch?sslmode=disable

DB_HOST=localhost
DB_PORT=5432
DB_USER=servicewatch
DB_PASSWORD=changeme
DB_NAME=servicewatch
DB_SSLMODE=disable

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# ─── Authentication ────────────────────────────────────────────────────────────
# Must be at least 32 characters. Change before deploying.
JWT_SECRET=change-me-to-a-secure-random-string-of-at-least-32-characters
JWT_EXPIRY=24h
BCRYPT_COST=12

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ─── Monitor / Scheduler ──────────────────────────────────────────────────────
MONITOR_WORKER_COUNT=10
MONITOR_SCHEDULER_INTERVAL=30s
MONITOR_DEFAULT_INTERVAL=5m
MONITOR_DEFAULT_TIMEOUT=30s
MONITOR_MAX_RESPONSE_BODY_BYTES=1048576

# SECURITY: Set to true ONLY for local development to allow monitoring localhost.
# Never set in production — it disables SSRF IP-range blocking.
MONITOR_ALLOW_PRIVATE_IPS=false

# ─── Server timeouts ──────────────────────────────────────────────────────────
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s
SERVER_SHUTDOWN_TIMEOUT=30s
